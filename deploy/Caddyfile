# SITE_ADDRESS: ":80" for plain HTTP, or a domain for automatic HTTPS.
{$SITE_ADDRESS} {
	# Voice recordings for /api/flicky/transcribe can be up to 25 MB.
	request_body {
		max_size 30MB
	}

	reverse_proxy app:3000

	header {
		-Server
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}
}
