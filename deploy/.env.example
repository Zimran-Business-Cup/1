# Copy to deploy/.env and fill in. deploy/.env is gitignored: never commit it.

# ":80" serves plain HTTP for local runs. In production put the domain here,
# e.g. SITE_ADDRESS=heforage.app, and point its A record at the server.
SITE_ADDRESS=:80

# Host ports. Keep 80/443 on the server; change them locally if they're taken.
HTTP_PORT=80
HTTPS_PORT=443

# Postgres password (required).
POSTGRES_PASSWORD=

# Mentor and Flicky. Without ANTHROPIC_API_KEY the app runs the demo mentor.
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# Stripe test mode for the Pro checkout (sk_test_…). Live keys are refused
# unless STRIPE_ALLOW_LIVE=1. PUBLIC_URL is where Stripe sends people back,
# e.g. https://heforage.app
STRIPE_SECRET_KEY=
PUBLIC_URL=
