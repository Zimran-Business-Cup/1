# Copy to deploy/.env and fill in. deploy/.env is gitignored: never commit it.

# ":80" serves plain HTTP for local runs. In production put the domain here,
# e.g. SITE_ADDRESS=1ry.space, and point its A record at the server.
SITE_ADDRESS=:80

# Host ports. Keep 80/443 on the server; change them locally if they're taken.
HTTP_PORT=80
HTTPS_PORT=443

# Postgres password (required).
POSTGRES_PASSWORD=

# Mentor and Flicky: Anthropic if its key is set, otherwise OpenRouter.
# With neither, the app runs the demo mentor and recorded Flicky answers.
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash-1017
# OPENROUTER_STT_MODEL=google/gemini-3.5-flash-lite

# Optional: Whisper on Groq for speech-to-text instead of the OpenRouter audio model.
GROQ_API_KEY=

# Stripe test key (sk_test_…) for the Pro checkout. PUBLIC_URL is where Stripe
# sends people back, e.g. https://heforage.app
STRIPE_SECRET_KEY=
PUBLIC_URL=
